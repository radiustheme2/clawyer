{
	"name": "clawyer",
	"version": "1.0.0",
	"description": "RadiusTheme WordPress Starter Theme for Place directory theme",
	"main": "index.js",
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"postinstall": "node scripts/patch-yargs.js && node scripts/patch-webpackbar.js && node scripts/patch-laravel-mix.js",
		"dev": "npm run development",
		"development": "mix",
		"watch": "mix watch",
		"production": "mix --production",
		"cleanup": "rm -rf build/* && rm -rf assets/**/*.map",
		"clean": "rm -rf build/*",
		"clean-temp": "rm -rf build/temp/",
		"package": "npm run development && npm run cleanup && npm run production --package && npm run clean-temp",
		"package-dev": "npm run cleanup && npm run dev --package",
		"zip": "npm run package && npm run dev --zip",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"keywords": [
		"wordpress",
		"theme",
		"starter"
	],
	"author": "Alessandro Castellani <me@radiustheme.com> (https://radiustheme.com)",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/RadiusTheme/"
	},
	"homepage": "https://github.com/RadiusTheme/",
	"devDependencies": {
		"@tinypixelco/laravel-mix-wp-blocks": "^1.1.0",
		"@wordpress/babel-preset-default": "^6.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^3.1.3",
		"@wordpress/eslint-plugin": "^9.0.5",
		"@wordpress/prettier-config": "^1.0.4",
		"@wordpress/scripts": "^30.12.0",
		"archiver": "^5.3.1",
		"browser-sync": "^1.3.7",
		"browser-sync-webpack-plugin": "^2.3.0",
		"cli-color": "^2.0.0",
		"emojic": "^1.1.16",
		"fs-extra": "^11.2.0",
		"jquery": "^3.6.0",
		"laravel-mix": "^6.0.49",
		"postcss": "^8.3.0",
		"resolve-url-loader": "^5.0.0",
		"rtlcss": "^4.1.1",
		"sass": "^1.85.1",
		"sass-loader": "^13.3.3",
		"wp-pot": "^1.10.2"
	}
}
